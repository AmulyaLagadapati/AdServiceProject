interface project.adservice.integrations
service HS_Epsilon_Services (
    input {
        record AddGenerationFilteringRequest (project.adservice.documenttypes:AddGenerationFilteringRequest);
    }
    output {
        record AdGenerationFilteringResponse (project.adservice.documenttypes:AdGenerationFilteringResponse);
    }
)
properties {
    visible: private;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: never;
    logOn: Error only;
    includePipeline: never;
    validateInput: false;
    validateOutput: false;
}
{
    SEQUENCE {
        comment: "Reject requests missing required fields (not fail-open)"
        IF (%AddGenerationFilteringRequest% == $null) {
            EXIT {
                exitFrom: "$flow"
                signal: "FAILURE"
                failureMessage: "AddGenerationFilteringRequest is required"
            }
        }
        MAP {
            comment: "Copy required fields to flat variables for checking"
            mapSource {
                record AddGenerationFilteringRequest (project.adservice.documenttypes:AddGenerationFilteringRequest);
            }
            mapTarget {
                String sessionId;
                String placement;
                String catalogId;
            }
            copy AddGenerationFilteringRequest/sessionId -> sessionId;
            copy AddGenerationFilteringRequest/placement -> placement;
            copy AddGenerationFilteringRequest/catalogId -> catalogId;
        }
        IF (%sessionId% == $null) {
            EXIT {
                exitFrom: "$flow"
                signal: "FAILURE"
                failureMessage: "sessionId is required"
            }
        }
        IF (%placement% == $null) {
            EXIT {
                exitFrom: "$flow"
                signal: "FAILURE"
                failureMessage: "placement is required"
            }
        }
        IF (%catalogId% == $null) {
            EXIT {
                exitFrom: "$flow"
                signal: "FAILURE"
                failureMessage: "catalogId is required"
            }
        }
        MAP {
            mapSource {
                String sessionId;
                String placement;
                String catalogId;
            }
            drop sessionId;
            drop placement;
            drop catalogId;
        }
    }
    TRY {
        MAP {
            comment: "Placeholder for the Epsilon ad generation call"
            mapSource {
                record AddGenerationFilteringRequest (project.adservice.documenttypes:AddGenerationFilteringRequest);
            }
            mapTarget {
                record AdGenerationFilteringResponse (project.adservice.documenttypes:AdGenerationFilteringResponse);
            }
            set AdGenerationFilteringResponse/memoryToken = "";
        }
    }
    CATCH {
        INVOKE pub.flow:getLastFailureCaught {
            output {
                mapSource {
                    String failureMessage;
                    String failureName;
                }
                mapTarget {
                    String errorMessage;
                    String errorType;
                }
                copy failureMessage -> errorMessage;
                copy failureName -> errorType;
            }
        }
        INVOKE pub.flow:debugLog {
            input {
                mapSource {
                    String errorMessage;
                    String errorType;
                }
                mapTarget {
                    String `message`;
                    String function;
                    String level;
                }
                set (variable) `message` = "HS_Epsilon_Services failed (%errorType%), returning no ads: %errorMessage%";
                set function = "HS_Epsilon_Services";
                set level = "Error";
            }
        }
        MAP {
            comment: "Fail open: empty ad response"
            mapSource {
                record AdGenerationFilteringResponse (project.adservice.documenttypes:AdGenerationFilteringResponse);
                Object failure;
                String failureMessage;
                String failureName;
                String errorMessage;
                String errorType;
                String `message`;
                String function;
                String level;
            }
            mapTarget {
                record AdGenerationFilteringResponse (project.adservice.documenttypes:AdGenerationFilteringResponse);
            }
            drop AdGenerationFilteringResponse/ads;
            drop AdGenerationFilteringResponse/banners;
            drop AdGenerationFilteringResponse/products;
            drop failure;
            drop failureMessage;
            drop failureName;
            drop errorMessage;
            drop errorType;
            drop `message`;
            drop function;
            drop level;
        }
    }
}
