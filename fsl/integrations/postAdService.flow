interface project.adservice.integrations
service postAdService (
    input {
        record AdServiceRequest (project.adservice.documenttypes:AdServiceRequest);
    }
    output {
        record AdServiceResponse (project.adservice.documenttypes:AdServiceResponse);
    }
)
properties {
    visible: private;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: never;
    logOn: Error only;
    includePipeline: never;
    validateInput: false;
    validateOutput: false;
}
{
    TRY {
        INVOKE project.adservice.integrations:AdService_Process {
            comment: "Build the ad response from the request"
            input {
                mapSource {
                    record AdServiceRequest (project.adservice.documenttypes:AdServiceRequest);
                }
                mapTarget {
                    record AdServiceRequest (project.adservice.documenttypes:AdServiceRequest);
                }
                copy AdServiceRequest -> AdServiceRequest;
            }
            output {
                mapSource {
                    record AdServiceResponse (project.adservice.documenttypes:AdServiceResponse);
                }
                mapTarget {
                    record AdServiceResponse (project.adservice.documenttypes:AdServiceResponse);
                }
                copy AdServiceResponse -> AdServiceResponse;
            }
        }
    }
    CATCH {
        INVOKE pub.flow:getLastFailureCaught {
            output {
                mapSource {
                    String failureMessage;
                }
                mapTarget {
                    String errorMessage;
                }
                copy failureMessage -> errorMessage;
            }
        }
        INVOKE pub.flow:debugLog {
            input {
                mapSource {
                    String errorMessage;
                }
                mapTarget {
                    String `message`;
                    String function;
                    String level;
                }
                set (variable) `message` = "postAdService failed, returning degraded response: %errorMessage%";
                set function = "postAdService";
                set level = "Error";
            }
        }
        MAP {
            comment: "Fail open: degraded response with no ads"
            mapSource {
                record AdServiceResponse (project.adservice.documenttypes:AdServiceResponse);
                Object failure;
                String failureMessage;
                String failureName;
            }
            mapTarget {
                record AdServiceResponse (project.adservice.documenttypes:AdServiceResponse);
            }
            set AdServiceResponse/status = "degraded";
            drop AdServiceResponse/banners;
            drop AdServiceResponse/sponsoredProducts;
            drop failure;
            drop failureMessage;
            drop failureName;
        }
    }
}
